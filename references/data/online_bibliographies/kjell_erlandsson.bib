@inproceedings{erlandsson2025breast_imaging_performance,
  author = {Erlandsson, Kjell and others},
  title = {Performance Evaluation of a Dual Headed Molecular Breast Imaging System},
  booktitle = {2025 IEEE Nuclear Science Symposium (NSS), Medical Imaging Conference (MIC) and Room Temperature Semiconductor Detector Conference (RSSD)},
  year = {2025},
  month = {November},
  abstract = {A prototype dual-headed Molecular Breast Imaging (MBI) system has been developed at Kromek and UCL. Each head consists of an array of CZT detectors with sub-pixel resolution and depth-of-interaction (DOI) capability equipped with multi-pinhole collimators, which allow multiplexing (MX). The system is stationary and provides limited-angle tomographic information. We have evaluated the performance of the prototype with phantom measurements in terms of lesion detection and dose reduction factor (DRF). ... In conclusion, our results show that a reduction in dose or scan time of up as a factor of 8 may be possible with our novel MBI system.}
}

@inproceedings{erlandsson2025breast_imaging_prototype,
  author = {Erlandsson, Kjell and others},
  title = {Phantom-Based Evaluation of Ultra-Fast Tomographic Molecular Breast Imaging Prototype},
  booktitle = {2025 IEEE Nuclear Science Symposium (NSS), Medical             Imaging Conference (MIC) and Room Temperature Semiconductor Detector Conference (RSSD)},
  year = {2025},
  month = {November},
  abstract = {A prototype of an ultra-low-dose stationary tomographic Molecular Breast Imaging (ULDMBI) system has been developed and built by Kromek. The system combines superior energy, position, and depth of interaction (DOI) resolution of CZT detectors... to mitigate the MBI drawbacks... without compromising diagnostic content.}
}

@article{erlandsson2025pet_clinics,
  author = {Erlandsson, Kjell and others},
  title = {Addressing Partial Volume Effects in Clinical PET Quantification: Modern Correction Strategies and Challenges},
  journal = {PET Clinics},
  year = {2025},
  month = {August},
  abstract = {The partial volume effect (PVE) is a significant source of error in PET imaging that leads to substantial biases in the quantification of radiopharmaceutical uptake. This effect arises due to the finite spatial resolution of the PET system, which causes image blurring and signal spillover between adjacent regions. ... In this review, we focus primarily on methods introduced over the past decade, which fall into 4 main categories: region-based methods, post-reconstruction image enhancement techniques, in-reconstruction resolution modelling (RM), and deep learning-based approaches.}
}

