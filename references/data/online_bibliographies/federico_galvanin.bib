@article{galvanin2024fisher_information,
  author = {Friso, A. and Galvanin, F.},
  title = {An optimization-free Fisher information driven approach for online design of experiments},
  journal = {Computers & Chemical Engineering},
  year = {2024},
  volume = {187},
  article_number = {108724},
  doi = {10.1016/j.compchemeng.2024.108724},
  abstract = {In this paper a Fisher Information Matrix Driven (FIMD) approach is introduced to tackle challenges in kinetic model identification. The methodology integrates a sampling-based experimental design approach with experiment ranking based on FIM to select the most informative experiment at each iteration. The effectiveness of the proposed design methodology is examined and discussed via two different case studies of increasing complexity: a fed-batch reactor for fermentation of baker's yeast and a nucleophilic aromatic substitution in a flow reactor system.}
}

