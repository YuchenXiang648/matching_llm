@article{hughes2026wherever,
  title={Wherever I May Roam: A Time-Resolved Wavelength-Dependent Study of the Roaming Dynamics in Acetaldehyde},
  author={Hughes, Derri J and Parkes, Michael A and Chapman, Richard T and Nrisimarmurty, M and Springate, Emma and Thompson, James O and others},
  journal={ACS Earth and Space Chemistry},
  year={2026},
  doi={10.1021/acsearthspacechem.6c00134.s001},
  abstract={Acetaldehyde represents a key carbonyl compound in star-forming regions of the Sagittarius B2 molecular cloud, where photolysis generates reactive intermediates central to astrochemical complex molecule formation. Yet, its dominant photodissociation mechanisms remain poorly understood. Here, we use extreme ultraviolet (21.5 eV) time-resolved photoelectron spectroscopy, supported by high level ab initio calculations, to investigate the wavelength-dependent photodissociation dynamics of acetaldehyde following excitation at 295 and 308 nm.}
}

@article{zhou2026observation,
  title={Observation of Concentration-Dependent Inversion of Response to Oxidizing Gases in Chemoresistive Metal Oxide Gas Sensors Resultting from Humidity Interference},
  author={Zhou, Pengfei and Tsang, Jone-Him and Zhu, Yiyun and Parkes, Michael A and Shen, Yanbai and Blackman, Christopher S},
  journal={ACS Sensors},
  year={2026},
  volume={11},
  number={2},
  pages={1106--1116},
  doi={10.1021/acssensors.5c02990},
  abstract={In this study, we investigate such inversion phenomena in Cr2O3-based sensors doped with Ti(IV), W, and Ni(II), alongside Ag-decorated WO3 sensors. Initial observations suggested inversion of response to O2, consistent with hypotheses involving carrier type transitions. These findings demonstrate that water contamination in the drying of the sensor as the sole contaminant responsible.}
}

@article{parkes2025kick,
  title={The Kick Inside: time-resolved mechanistic insights into the DUV-driven interconversion of pyrazole to imidazole},
  author={Hughes, Derri J and Ng, Wei Bo and Chapman, Richard T and Healing, George and Parkes, Michael A and Rigden, Jennifer and Smith, Oliver J and Springate, Emma and Thompson, James O F and Walmsley, Tiffany and Woodhouse, Joanne L and Minns, Russell S},
  journal={Physical Chemistry Chemical Physics},
  year={2025},
  volume={27},
  number={37},
  pages={19762--19771},
  doi={10.1039/d5cp02684a},
  abstract={The interconversion of aromatic heterocyclic molecules via photochemical scaffold-hopping provides a clean and efficient formation route to otherwise syntentially challenging targets. To study the photochemically driven isomerisation of pyrazole to imidazole, we combine femtosecond time-resolved photoelectron spectroscopy experiments with ab initio electronic structure calculations. Our results show that excitation to the 1ππ* state in the gas-phase provides a directed ‘kick’ to the system, resulting in the breaking of the N–N bond and formation of a ring-opened biradical intermediate on the vibrationally hot electronic ground state on ultrafast (sub-90 fs) timescales. Once on the vibrationally hot electronic ground state, production of the imidazole photoproduct proceeds via the formation of a three membered ring that subsequently opens and shifts the relative position of the two nitrogen atoms.}
}

