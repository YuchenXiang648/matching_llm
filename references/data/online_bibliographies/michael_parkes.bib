@article{abma2024direct,
  title={Direct Observation of a Roaming Intermediate and Its Dynamics},
  author={Abma, Grite L and Parkes, Michael A and Razmus, Weronika O and Zhang, Yu and Wyatt, Adam S and Springate, Emma and others},
  journal={Journal of the American Chemical Society},
  year={2024},
  doi={10.1021/jacs.4c01543},
  abstract={We present a direct and time-resolved experimental measurement of roaming. By measuring the photoelectron spectrum of UV-excited acetaldehyde with a femtosecond extreme ultraviolet pulse, we captured spectral signatures of all of the key reactive structures, including that of the roaming intermediate. This provided a direct experimental measurement of the roaming process and allowed us to identify the time scales by which the roaming intermediate is formed and removed.}
}

@article{estrin2024plasma,
  title={Plasma Jet Mediated Reduction of Metal Salt},
  author={Estrin, Francis Lockwood and Hagger, Oliver S. J. and Parkes, Michael A. and Sener, M. Emre and Caruana, Daren J.},
  journal={ECS Meeting Abstracts},
  year={2024},
  doi={10.1149/MA2024-01241399mtgabs},
  abstract={We demonstrate electrodeposition where the plasma acts as both an electrolyte and electrode, to deposit metallic conductive coatings. In conventional electroplating metal ions are reduced at a working electrode with an applied electrochemical potential. Here an RF atmospheric pressure plasma jet (APPJ) is able to induce a electrochemical reduction due to the presence of free electrons.}
}

@article{estrin2024metal,
  title={Metal Painting by Plasma Jet},
  author={Estrin, Francis Lockwood and Hagger, Oliver S. J. and Sener, M. Emre and Caruana, Daren J.},
  journal={Advanced Materials Interfaces},
  year={2024},
  doi={10.1002/admi.202400256},
  abstract={Conducting metal interconnections are essential to link electronic components or multiple circuits for electronic device fabrication. Scalable, rapid, and sustainable methods for printing adherent metal interconnections on dielectric materials are lacking. Here a breakthrough single-step and rapid process to deposit highly conducting metal tracks is introduced, using an atmospheric pressure plasma jet.}
}

@article{hagger2025additive,
  title={Additive metal printing on multi materials using an atmospheric pressure plasma jet on a 5-Axis platform},
  author={Hagger, Oliver S. J. and Parkes, Michael A. and Estrin, Francis Lockwood and Agrotis, Stefanos and Parkin, Ivan P. and Handoko, Albertus D. and Caruana, Daren J.},
  journal={Materials & Design},
  year={2025},
  doi={10.1016/j.matdes.2025.113681},
  abstract={Post-production embellishment of objects with metal tracks presents challenges, due to the need for multiple processing steps and the complexity of navigating intricate substrate geometries. Here we describe a flexible approach to deposit conducting metal tracks on 3D objects using an atmospheric pressure plasma jet (APPJ).}
}

