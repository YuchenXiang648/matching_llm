@article{facini_2026_observation_pair,
  title={Observation of pair production of longitudinally polarized ZZZ bosons in four-lepton final state with the ATLAS detector},
  author={Facini, Gabriel and others},
  journal={arXiv preprint},
  year={2026},
  abstract={The production of two longitudinally polarized bosons is measured using proton–proton collision data recorded by the ATLAS experiment at a center-of-mass energy $\sqrt{s}=13.6$ TeV and with an integrated luminosity of 164 fb$^{-1}$. The candidate events are reconstructed using two same-flavor opposite-charge electron or muon pairs. The production of two simultaneously longitudinally polarized bosons is achieved, with observed and expected significances of 6.5 and 5.6 standard deviations, respectively.}
}

@article{facini_2026_efficiency_b_jets,
  title={Simultaneous efficiency measurements of bbb- and ccc-jets in tt\textsuperscript{-1}t\textsuperscript{-1} events from $\sqrt{s}=13.6$ TeV pp collisions with the ATLAS detector},
  author={Facini, Gabriel and others},
  journal={arXiv preprint},
  year={2026},
  abstract={This paper reports simultaneous measurements of the efficiencies with which b-jets are identified, and c-jets are misidentified as b-jets, by the single-transformer-based GN2 tagger that is currently used in the ATLAS experiment at the LHC. The measurements use $\text{t}\bar{\text{t}}$ events where one of the $W$ bosons decays into an electron or muon and a neutrino, and the other decays into a quark–antiquark pair, together with the known $\text{t} \to \text{b}W$ and $W \to \text{cs}$ branching fractions. The data were collected from $\sqrt{s}=13.6$ TeV proton–proton collisions by the ATLAS detector and correspond to an integrated luminosity of 56 fb$^{-1}$. Events are reconstructed using a kinematic likelihood technique which maps the jets to the $\text{t}\bar{\text{t}}$ decay products. The b-jet tagging efficiency is measured from jets arising from leptonically decaying top quarks and the c-jet mistagging efficiency is obtained from jets arising from hadronic $W$ decays. The efficiencies are measured as a function of jet transverse momentum in intervals of the tagging-variable distribution. The b-jet (c-jet) tagging efficiency measurements reach a precision of better than 2% (5%). Each b-jet efficiency is combined with an independent measurement using $\text{t}\bar{\text{t}}$ events where both $W$ bosons decay leptonically.}
}

